# ================================================
# PM Buddy Backend - .dockerignore
# Keeps production backend images slim, secure, and fast
# ================================================

# 1. Git & Version Control
.git/
.gitignore

# 2. Python Virtual Environment (CRITICAL: host venv must never enter container)
.venv/
venv/
env/
ENV/

# 3. Python Cache & Compiled Artifacts
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Testing, Coverage & Quality Assurance
tests/
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
.mypy_cache/
.ruff_cache/
.pyright/

# 5. Local Secrets & Environment Files
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.token
*.credentials

# 6. Build Artifacts & Packaging
build/
dist/
*.egg-info/
.eggs/

# 7. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 8. Logs & Temporary Runtime Files
*.log
logs/
tmp/
temp/
*.tmp
*.temp
uploads/
storage/
*.db
*.sqlite3
