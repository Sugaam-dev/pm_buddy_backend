# ==============================================================================
# PM Buddy Backend Environment Configuration (Hostinger Docker)
# Company: pmrg solution llp | Product: pm buddy
# ==============================================================================

# Application Environment
ENVIRONMENT=production
APP_NAME=PM Buddy - AI Operations Platform

# Domains & CORS
# Comma-separated list of allowed frontend origins (e.g. Vercel domain or custom domain)
FRONTEND_URL=https://your-app.vercel.app,https://yourdomain.com
BACKEND_URL=https://api.yourdomain.com

# Cryptography (Base64-encoded 32-byte encryption key for integration tokens)
# Generate with: python -c "import secrets, base64; print(base64.b64encode(secrets.token_bytes(32)).decode())"
ENCRYPTION_KEY=dGhpcy1pcy1hLTMyLWJ5dGUtc2VjcmV0LWtleS0xMjM=

# Database & Supabase
# PostgreSQL connection string with asyncpg driver
DATABASE_URL=postgresql+asyncpg://postgres:your_db_password@your_db_host:5432/postgres
NEXT_PUBLIC_SUPABASE_URL=https://your-project.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=your-supabase-anon-key
SUPABASE_SERVICE_ROLE_KEY=your-supabase-service-role-key
SUPABASE_SECRET_KEY=your-supabase-service-role-key

# Redis (Optional/Caching)
REDIS_URL=redis://localhost:6379/0

# AI / LLM Configuration
LLM_PROVIDER=gemini
LLM_MODEL=gemini-1.5-flash
GEMINI_API_KEY=your-google-gemini-api-key
OPENAI_API_KEY=
ANTHROPIC_API_KEY=

# Calendar Integrations (Optional)
DEFAULT_CALENDAR_PROVIDER=local
GOOGLE_CLIENT_ID=
GOOGLE_CLIENT_SECRET=
MICROSOFT_CLIENT_ID=
MICROSOFT_CLIENT_SECRET=
