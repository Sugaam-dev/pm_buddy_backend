# ================================================
# PM Buddy Backend - .gitignore
# FastAPI / Python production safety rules
# ================================================

# 1. Secrets & Environment Files
.env
.env.*
!.env.example
!.env.template
*.pem
*.key
*.crt
*.p12
*.pfx
*.token
*.secret
*.credentials
service-account*.json
*-service-account.json

# 2. Virtual Environments (Critical: host venv must never be pushed)
.venv/
venv/
env/
ENV/

# 3. Python Compiled & Cache Files
__pycache__/
*.py[cod]
*$py.class
*.so

# 4. Packaging & Build Outputs
build/
dist/
*.egg-info/
.eggs/

# 5. Testing & Coverage Artifacts
.pytest_cache/
.coverage
.coverage.*
htmlcov/
coverage.xml
*.cover

# 6. Linters & Type-Check Caches
.mypy_cache/
.pyright/
.ruff_cache/
.pylint.d/

# 7. Logs & Temporary Files
*.log
logs/
tmp/
temp/
*.tmp
*.temp

# 8. Local Databases & Storage
*.db
*.sqlite
*.sqlite3
uploads/
reports/
generated/
storage/
chroma/
chroma_db/
vector_store/
embeddings/

# 9. IDE & OS Metadata
.vscode/
.idea/
*.swp
*.swo
*~
.DS_Store
Thumbs.db
desktop.ini

# 10. Local Development Tooling
.supabase/
.docker/
docker-data/
docker-volumes/
.ipynb_checkpoints/
.ai/
.ai-cache/
.agent-cache/